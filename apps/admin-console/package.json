{
  "name": "sentinel-mcp-admin-console",
  "version": "0.1.0",
  "private": true,
  "description": "Personal R&D console for Sentinel MCP policy IDE",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:a11y": "vitest run src/components/__tests__/MissionControl.a11y.test.tsx",
    "test:e2e": "playwright test",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "verify:frontend": "npm run lint && npm run test && npm run build && npm run perf:budget",
    "verify:frontend:full": "npm run verify:frontend && npm run test:e2e",
    "release:gate": "node scripts/frontend-release-gate.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.11",
    "next": "^16.3.0-canary.23",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.10.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.0-canary.23",
    "jest-axe": "^9.0.0",
    "jsdom": "^27.4.0",
    "start-server-and-test": "^2.0.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "axios": "^1.16.1",
    "follow-redirects": "^1.16.0",
    "lodash": "^4.18.1",
    "brace-expansion@<1.1.13": "1.1.13",
    "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
    "picomatch@<2.3.2": "2.3.2",
    "picomatch@>=4.0.0 <4.0.4": "4.0.4",
    "postcss": "^8.5.15",
    "ws": "^8.20.1"
  }
}
